{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console"
    ],
    "MinimiumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Information"
      }
    },
    "WriteTo": {
      "Name": "Console"
    },
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  },
  "ConnectionStrings": {
    "Default": "Host=localhost;Port=5432;Database=estore;Username=estore;Password=estore"
  },
  "JwtSettings": {
    "Secret": "", // Hidden within dotnet user-secrets
    "ExpirationTimeInMinutes": 120,
    "Issuer": "EStore.API",
    "Audience": "EStore.API"
  },
  "ElasticSearchSettings": {
    "BaseUrl": "http://localhost:9200",
    "DefaultIndex": "products"
  },
  "StorageSettings": {
    "ProductsBucket": "estore-api-products",
    "CustomersBucket": "estore-api-customers"
  }
}
